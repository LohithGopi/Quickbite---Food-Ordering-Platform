generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  cartData  Json     @default("{}")

  // Relations
  orders    Order[]
}

model Food {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String
  category    String
}

model Order {
  id            Int      @id @default(autoincrement())

  // Relation with User
  userId        Int
  user          User     @relation(fields: [userId], references: [id])

  // Order details
  items         Json
  amount        Float
  address       Json

  // Order tracking
  status        String   @default("Food Processing")
  date          DateTime @default(now())

  // Payment
  payment       Boolean  @default(false)
  paymentMethod String   @default("Stripe")
}